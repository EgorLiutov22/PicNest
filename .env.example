# ============================================================================
# PicNest Marketplace API - Environment Variables Configuration
# ============================================================================
# Пример файла конфигурации для разработки и продакшена
# Скопируйте этот файл в .env и настройте под себя
# Автор: PicNest Backend Team
# Дата: 2026-10-21
# ============================================================================

# ==========================================================================
# Application Settings
# ==========================================================================

# Окружение (development, production)
ENVIRONMENT=production

# Режим отладки (true/false) - включайте только для разработки!
DEBUG=false

# Версия приложения
APP_VERSION=1.0.0

# ==========================================================================
# Database Configuration (PostgreSQL)
# ==========================================================================

# URL базы данных PostgreSQL
# Формат: postgresql+asyncpg://username:password@host:port/database_name
DATABASE_URL=postgresql+asyncpg://picnest_user:picnest_pass@localhost:5432/picnest_db

# Отдельные переменные для PostgreSQL (используются в docker-compose)
POSTGRES_USER=picnest_user
POSTGRES_PASSWORD=picnest_pass
POSTGRES_DB=picnest_db

# ==========================================================================
# Authentication Configuration
# ==========================================================================

# Секретный ключ для подписи JWT токенов
# !!! ОБЯЗАТЕЛЬНО ИЗМЕНИТЕ В ПРОДАКШЕНЕ И СДЕЛАЙТЕ СЛОЖНЫМ !!!
SECRET_KEY=your-super-secret-key-change-in-production-use-random-string-here

# Алгоритм шифрования (HS256, HS384, HS512)
ALGORITHM=HS256

# Время жизни access токена (в минутах)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Время жизни refresh токена (в днях)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================================================
# CORS Configuration
# ==========================================================================

# Разрешенные домены для CORS (через запятую без пробелов)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://picnest.com

# Разрешить cookies (true/false)
CORS_ALLOW_CREDENTIALS=true

# Разрешенные HTTP методы (через запятую)
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Разрешенные заголовки (через запятую)
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Requested-With,Accept

# ==========================================================================
# Security Headers Configuration
# ==========================================================================

# Хост для HSTS (строгий перенаправление на HTTPS)
HSTS_MAX_AGE=31536000

# Content-Security-Policy директивы
CSP_DEFAULT_SRC=self
CSP_SCRIPT_SRC=self unsafe-inline unsafe-eval
CSP_STYLE_SRC=self unsafe-inline
CSP_IMG_SRC=self data: https:

# ==========================================================================
# Sentry Configuration (для отслеживания ошибок)
# ==========================================================================

# DSN для Sentry.io (оставьте пустым для отключения)
SENTRY_DSN=https://xxx@sentry.io/yyy

# Уровень трассировки транзакций (0.0-1.0, 0.1 для продакшена)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Версия приложения для Sentry
SENTRY_RELEASE_VERSION=1.0.0

# ==========================================================================
# Redis Configuration (для кэширования и rate limiting)
# ==========================================================================

# URL Redis сервера
REDIS_URL=redis://localhost:6379/0

# Использовать Redis для production rate limiting (true/false)
USE_REDIS_FOR_RATE_LIMITING=true

# ==========================================================================
# Prometheus Metrics Configuration
# ==========================================================================

# Включить сбор метрик Prometheus (true/false)
PROMETHEUS_ENABLED=true

# Хост для экспорта метрик (для scrape configurations)
PROMETHEUS_EXPORTER_HOST=localhost
PROMETHEUS_EXPORTER_PORT=8000

# ==========================================================================
# Logging Configuration
# ==========================================================================

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=WARNING

# Формат логов (console, json)
LOG_FORMAT=json

# Путь к файлу логов
LOG_FILE=/app/logs/app.log

# ==========================================================================
# Rate Limiting Configuration
# ==========================================================================

# Включить rate limiting (true/false)
RATE_LIMIT_ENABLED=true

# Default rate limit per IP (формат: число/единица времени)
DEFAULT_RATE_LIMIT=100/hour

# Максимальное количество попыток входа за минуту
LOGIN_MAX_ATTEMPTS_PER_MINUTE=5

# Максимальное количество регистраций в минуту
REGISTER_MAX_PER_MINUTE=3

# ==========================================================================
# Monitoring & Observability
# ==========================================================================

# Grafana Admin Password (для pgadmin/grafana)
GRAFANA_ADMIN_PASSWORD=admin

# PgAdmin Default Email
PGADMIN_DEFAULT_EMAIL=admin@example.com

# PgAdmin Default Password
PGADMIN_DEFAULT_PASSWORD=admin

# ==========================================================================
# Deployment Configuration
# ==========================================================================

# Количество реплик приложения в production
REPLICAS=2

# Resource limits для контейнеров (CPU, Memory)
APP_CPU_LIMIT=1
APP_MEMORY_LIMIT=512M
APP_CPU_RESERVATION=0.5
APP_MEMORY_RESERVATION=256M

# ==========================================================================
# Development Only Settings (НЕ ИСПОЛЬЗОВАТЬ В ПРОДАКШЕНЕ!)
# ==========================================================================

# Разрешить SQL logging для отладки
SQL_LOGGING=false

# Показать SQL запросы в логах
SHOW_SQL_QUERIES=false

# Auto-create database tables при запуске
AUTO_CREATE_TABLES=true

# Seed data при первом запуске (true/false)
SEED_DATA=false

# ==========================================================================
# Production Security Checklist
# ==========================================================================
# Перед деплоем в production убедитесь что:
# 1. SECRET_KEY установлен на случайную длинную строку
# 2. DATABASE_URL содержит надежные учетные данные
# 3. SENTRY_DSN настроен (для отслеживания ошибок)
# 4. CORS_ALLOWED_ORIGINS ограничен продакшен доменами
# 5. DEBUG=false
# 6. ENVIRONMENT=production
# 7. Все пароли и ключи заменены на production значения
# 8. SSL/TLS настроен для HTTPS
# 9. Firewall настроен правильно
# 10. Backup стратегия настроена


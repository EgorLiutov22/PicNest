# ============================================================================
# PicNest — production environment (ШАБЛОН)
# ============================================================================
# Это шаблон. Реальный .env.production создаётся автоматически в deploy.py:
# пароли и SECRET_KEY генерируются случайно и не попадают в git
# (.env.production в .gitignore).
#
# Если файл уже существует, deploy.py НЕ перезаписывает его — секреты
# сохраняются между деплоями.
#
# ВАЖНО: этот файл читается дважды:
#   1) docker compose --env-file .env.production  → подстановка ${...} в compose
#   2) env_file: .env.production в сервисах       → переменные внутри контейнеров
# Поэтому значения не должны содержать символы $ и " без экранирования.
# ============================================================================

# --- Приложение -------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false
APP_VERSION=1.0.0

# --- PostgreSQL -------------------------------------------------------------
# Пароль генерируется deploy.py (openssl rand -hex 24). Значение в
# DATABASE_URL обязано совпадать с POSTGRES_PASSWORD, иначе контейнер app
# не подключится к БД.
POSTGRES_USER=picnest
POSTGRES_PASSWORD=__GENERATED__
POSTGRES_DB=picnest

DATABASE_URL=postgresql+asyncpg://picnest:__GENERATED__@db:5432/picnest

# --- Redis ------------------------------------------------------------------

REDIS_URL=redis://redis:6379/0
USE_REDIS_FOR_RATE_LIMITING=true

# --- Аутентификация ---------------------------------------------------------
# SECRET_KEY подписывает JWT. Генерируется deploy.py.
# Смена ключа разлогинит всех пользователей (все выданные токены станут
# невалидными) — меняйте только осознанно.
SECRET_KEY=__GENERATED__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS -------------------------------------------------------------------
# НЕ используйте "*": в main.py allow_credentials=True, а по спецификации
# CORS браузер отвергает wildcard вместе с credentials — фронтенд молча
# перестанет получать ответы. Перечислите origin'ы явно.
#
# Пока домен не настроен — добавьте адрес фронтенда по IP:
#   http://83.141.67.249,http://83.141.67.249:3000
# После настройки api.picnest.ru:
#   https://picnest.ru,https://www.picnest.ru
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Requested-With,Accept

# --- Безопасность -----------------------------------------------------------

HSTS_MAX_AGE=31536000
CSP_DEFAULT_SRC=self
CSP_SCRIPT_SRC=self unsafe-inline unsafe-eval
CSP_STYLE_SRC=self unsafe-inline
CSP_IMG_SRC=self data: https:

# --- Observability ----------------------------------------------------------

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE_VERSION=1.0.0

PROMETHEUS_ENABLED=true
PROMETHEUS_EXPORTER_HOST=0.0.0.0
PROMETHEUS_EXPORTER_PORT=8000

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/app.log

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATED__

# --- Rate limiting (уровень приложения) -------------------------------------

RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT=100/hour
LOGIN_MAX_ATTEMPTS_PER_MINUTE=5
REGISTER_MAX_PER_MINUTE=3

# --- Прочее -----------------------------------------------------------------

SQL_LOGGING=false
SHOW_SQL_QUERIES=false
SEED_DATA=false

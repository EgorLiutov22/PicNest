# ============================================================================
# .dockerignore — что НЕ отправлять в контекст сборки Docker
# ============================================================================
# Уменьшает контекст с десятков мегабайт до сотен килобайт и, что важнее,
# не даёт секретам (.env) попасть внутрь образа.
# ============================================================================

# Секреты и локальные конфиги
.env
.env.*
!.env.example
*.pem
*.key

# Git и CI
.git
.gitignore
.github

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Тесты и документация не нужны в runtime-образе
tests/
app/tests/
docs/
deploy/
*.md
Makefile
pytest.ini
.pre-commit-config.yaml

# Локальные данные и логи
logs/
data/
*.log
*.db
*.sqlite*
.DS_Store
